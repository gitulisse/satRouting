# Force Unix (LF) line endings for all files
# This ensures consistency across Windows, macOS, and Linux

# All text files use LF
* text=auto eol=lf

# Shell scripts MUST be LF
*.sh text eol=lf

# Python files
*.py text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Docker files
Dockerfile text eol=lf
.dockerignore text eol=lf

# Markdown
*.md text eol=lf

# JSON
*.json text eol=lf

# Config files
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# Scripts (no conversion)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.whl binary
*.pyc binary
*.pyo binary
__pycache__/ binary
*.so binary
*.dll binary
*.exe binary
